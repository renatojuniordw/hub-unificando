# ============================================================================
# .env.example — hub-unificando
# Copy to .env and fill in the required values before running the app.
# ============================================================================

# === Core ===
NODE_ENV="development"
PORT="11020"

# === Database (PostgreSQL 16 + pgvector) ===
# Local docker-compose defaults are used in docker-compose.yml; override here.
DATABASE_URL="postgresql://hub:hub@localhost:11022/hub_unificando"

# === Redis (queue + optional search cache) ===
REDIS_URL="redis://localhost:11023"
REDIS_ENABLED="true"

# === Admin (write endpoints: POST /ingest/jobs, MCP executar_ingestao) ===
# Generate with: openssl rand -base64 32
ADMIN_API_KEY=""

# === Scan root (parent folder containing the sibling projects) ===
HUB_SCAN_ROOT="/Users/renatobezerra/Developer/Unificando Hub"

# === Embeddings (on-device Transformers.js) ===
# Multilingual e5 family: small 384d | base 768d | large 1024d.
# "passage: " / "query: " prefixes — compatible with med-unificando embeddings.
EMBEDDING_MODEL="Xenova/multilingual-e5-base"
EMBEDDING_DIMS="768"
EMBEDDING_CACHE_DIR="/tmp/.transformers-cache"
EMBEDDING_BATCH_SIZE="50"

# === Ingestion queue ===
MAX_CONCURRENT_JOBS="2"
INGESTION_RETRIES="3"

# === MCP Server (Streamable HTTP at /mcp + stdio mode) ===
# If set, requires "Authorization: Bearer <key>" on every MCP request.
MCP_API_KEY=""
# Extra allowed origins (comma separated) besides localhost/127.0.0.1.
MCP_ALLOWED_ORIGINS=""
# Session TTL in minutes (sliding renewal).
MCP_SESSION_TTL_MIN="60"
# true = pure JSON responses | false = SSE (spec Streamable HTTP).
MCP_ENABLE_JSON_RESPONSE="false"
# Rate limit for MCP requests per minute per IP.
MCP_RATE_LIMIT="120"

# === API rate limits (requests per minute per IP) ===
THROTTLE_READ="120"
THROTTLE_WRITE="30"

# === CORS (default: localhost:11020, plus MCP_ALLOWED_ORIGINS) ===
CORS_ORIGINS="http://localhost:11020"

# === Optional search cache (Redis, short TTL) ===
SEARCH_CACHE_TTL_SECONDS="60"